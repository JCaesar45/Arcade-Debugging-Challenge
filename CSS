/* Reset some default styles */
body {
  margin: 0;
  padding: 0;
  font-family: "Orbitron", sans-serif;
  background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
  color: #fff;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Import a sci-fi font for arcade vibe */
@import url("https://fonts.googleapis.com/css2?family=Orbitron:wght@500&display=swap");

.container {
  background-color: rgba(0, 0, 0, 0.8);
  padding: 30px;
  border-radius: 15px;
  box-shadow: 0 0 20px #00ffe3, 0 0 40px #00ffe3 inset;
  max-width: 500px;
  width: 90%;
  text-align: center;
  animation: glow 1.5s infinite alternate;
}

/* Neon glow animation for the container */
@keyframes glow {
  from {
    box-shadow: 0 0 20px #00ffe3, inset 0 0 40px #00ffe3;
  }
  to {
    box-shadow: 0 0 40px #00ffe3, inset 0 0 20px #00ffe3;
  }
}

.title {
  font-size: 2em;
  color: #00ffe3;
  margin-bottom: 20px;
  text-shadow: 0 0 10px #00ffe3, 0 0 20px #00ffe3;
}

.scoreboard {
  margin-bottom: 20px;
}

.score {
  font-size: 1.2em;
  margin: 8px 0;
  padding: 10px;
  background-color: #222;
  border-radius: 10px;
  box-shadow: inset 0 0 10px #00ffe3;
  transition: all 0.3s ease;
}

#counter-value,
#score-value,
#coins-value,
#health-value {
  font-weight: bold;
  color: #00ffe3;
}

.instructions {
  font-size: 1em;
  margin-bottom: 20px;
  padding: 10px;
  background-color: #111;
  border-radius: 10px;
  box-shadow: inset 0 0 10px #00ffe3;
  text-align: left;
}

.instructions p {
  margin: 0 0 10px 0;
  font-weight: bold;
}

.instructions ul {
  padding-left: 20px;
  margin: 0;
}

.btn {
  background-color: #00ffe3;
  color: #000;
  padding: 12px 25px;
  font-size: 1.2em;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-family: "Orbitron", sans-serif;
  box-shadow: 0 0 10px #00ffe3, inset 0 0 10px #00ffe3;
  transition: all 0.3s ease;
}

.btn:hover {
  background-color: #00c6b3;
  box-shadow: 0 0 20px #00ffe3, inset 0 0 20px #00ffe3;
}
